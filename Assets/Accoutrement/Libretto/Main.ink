// ==========================================
// 전역 변수 정의
// ==========================================
// 씬 1 상태 플래그
VAR s1_talked_c1 = false
VAR s1_talked_c2 = false
VAR s1_interacted_o1 = false

// 씬 2 상태 플래그
VAR s2_talked_c1 = false
VAR s2_talked_c2 = false

// 씬 3 상태 플래그
VAR s3_talked_c1 = false
VAR s3_talked_c2 = false


// ==========================================
// [Scene 1] 시작의 방
// ==========================================
=== Scene_1 ===

// 캐릭터 1 버튼
= btn_c1
{ s1_talked_c1 && s1_talked_c2:
    // [m3] 둘 다 대화한 적이 있을 때
    c1: "너도 그 녀석과 이미 이야기해봤구나. 그럼 다음 계획을 세워보자."
- else:
    // [m1] 기본 대사
    c1: "처음 보는 얼굴이네. 난 c1이야. 방을 나갈 방법을 찾고 있어."
}
~ s1_talked_c1 = true
-> END

// 캐릭터 2 버튼
= btn_c2
{ s1_talked_c1 || s1_talked_c2:
    // [m4] 둘 중 한 명이라도 대화한 적이 있을 때
    c2: "정보는 어느 정도 모인 것 같네. 서두르는 게 좋겠어."
- else:
    // [m2] 둘 다 처음일 때
    c2: "안녕. 난 c2야. 여기 갇힌 지 꽤 됐어."
}
~ s1_talked_c2 = true
-> END

// 오브젝트 1 (단서/열쇠 등) 버튼
= btn_o1
바닥에 떨어진 낡은 문양의 열쇠를 발견했다.
~ s1_interacted_o1 = true
-> END

// 오브젝트 0 (출구/문) 버튼 -> 씬 전환 판별
= btn_o0
{ s1_interacted_o1:
    열쇠로 굳게 닫힌 정문을 열었다. 밝은 빛이 쏟아져 들어온다.
    #screen:Scene_2
    -> END
- else:
    문이 잠겨 있어 비상 통로의 환기구를 통해 억지로 기어 나갔다.
    #screen:Scene_3
    -> END
}


// ==========================================
// [Scene 2] 밝은 정원 (o1과 상호작용 후 진입)
// ==========================================
=== Scene_2 ===

= btn_c1
{ s2_talked_c1 && s2_talked_c2:
    // [m3]
    c1: "정원 분수대 주변을 둘 다 확인했으니 이제 탈출구를 찾자."
- else:
    // [m1]
    c1: "열쇠 덕분에 무사히 정원으로 나왔네. 공기가 훨씬 맑아."
}
~ s2_talked_c1 = true
-> END

= btn_c2
{ s2_talked_c1 || s2_talked_c2:
    // [m4]
    c2: "정원 탐색도 슬슬 마무리되어 가는 것 같군."
- else:
    // [m2]
    c2: "여기가 저택 바깥 정원인가 봐. 아직 안심하긴 일러."
}
~ s2_talked_c2 = true
-> END


// ==========================================
// [Scene 3] 어두운 지하 수로 (o1 없이 진입)
// ==========================================
=== Scene_3 ===

= btn_c1
{ s3_talked_c1 && s3_talked_c2:
    // [m3]
    c1: "축축하고 위험하지만, 둘 다 무사해서 다행이야."
- else:
    // [m1]
    c1: "콜록... 환기구가 무너져서 지하 수로로 떨어졌어. 다친 덴 없어?"
}
~ s3_talked_c1 = true
-> END

= btn_c2
{ s3_talked_c1 || s3_talked_c2:
    // [m4]
    c2: "물소리가 점점 거세지고 있어. 여기서 어서 빠져나가야 해."
- else:
    // [m2]
    c2: "어둡고 축축해... 이런 곳으로 떨어질 줄은 몰랐는데."
}
~ s3_talked_c2 = true
-> END